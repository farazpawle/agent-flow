      "caller_nid": "crawlerservice_startcrawl",
      "callee": "(async () => {\n        await db.createKnowledgeSource(source);\n        crawlProgress.publish({ progressId, sourceId: source.id, phase: \"queued\", message: \"Queued\" });\n        try {\n            const crawled = await runStrategy(source, input.urls, progressId);\n            await ingestCrawled(source, crawled, progressId);\n            source.status = \"ready\";\n            source.updatedAt = new Date();\n            source.pageCount = crawled.length;\n            await db.saveKnowledgeSource(source);\n            crawlProgress.publish({\n                progressId,\n                sourceId: source.id,\n                phase: \"completed\",\n                message: `Completed: ${crawled.length} pages`,\n                pagesCrawled: crawled.length,\n                pagesTotal: crawled.length,\n            });\n            return source;\n        } catch (err) {\n            const msg = err instanceof Error ? err.message : String(err);\n            source.status = \"failed\";\n            source.errorMessage = msg;\n            source.updatedAt = new Date();\n            await db.saveKnowledgeSource(source);\n            crawlProgress.publish({\n                progressId,\n                sourceId: source.id,\n                phase: \"failed\",\n                errorMessage: msg,\n            });\n            throw err;\n        }\n    })",
