# MCP Chain of Thought Environment Variables Configuration Example
# Copy this file to .env and customize as needed

# ============================
# Basic Configuration
# ============================

# Preferred readable names are used below.
# Legacy names are still supported for backward compatibility.

# Task data storage directory (absolute path)
DATA_DIRECTORY=

# Enable thought chain
THOUGHT_CHAIN_ENABLED=true

# Set Templates
# Specifies the template set to use for prompts.
# Default is 'en'. Currently available options are 'en' and 'zh'.
# To use custom templates, copy the 'src/prompts/templates_en' directory
# to the location specified by DATA_DIRECTORY, rename the copied directory
# (e.g., to 'my_templates'), and set PROMPT_TEMPLATE_SET to the new directory name (e.g., 'my_templates').
PROMPT_TEMPLATE_SET=en

# Enable GUI interface
# If set to true, a file named 'WebGUI.md' will be created in the DATA_DIRECTORY.
# This file will contain a local web address you can open in your browser to access the GUI.
# Default is false.
WEB_UI_ENABLED=false

# Enable Detailed Mode
# If set to true, records per-task conversation history for the dashboard.
DETAILED_MODE_ENABLED=false

# Auto-open Web UI in browser when the primary GUI server starts.
# Default behavior is enabled.
# Set to false to disable automatic browser launch.
AUTO_OPEN_WEB_UI=true

# Optional Web UI port (default: 54544)
# WEB_UI_PORT=54544

# ============================
# Prompt Customization
# ============================

# Task Planning (planTask) - Complete Override
# MCP_PROMPT_PLAN_TASK=

# Task Planning (planTask) - Append Content
# MCP_PROMPT_PLAN_TASK_APPEND=

# Task Analysis (analyzeTask) - Complete Override
# MCP_PROMPT_ANALYZE_TASK=

# Task Analysis (analyzeTask) - Append Content
# MCP_PROMPT_ANALYZE_TASK_APPEND=

# Solution Evaluation (reflectTask) - Complete Override or Append
# MCP_PROMPT_REFLECT_TASK=
# MCP_PROMPT_REFLECT_TASK_APPEND=

# Task Breakdown (splitTasks) - Complete Override or Append
# MCP_PROMPT_SPLIT_TASKS=
# MCP_PROMPT_SPLIT_TASKS_APPEND=

# Task Execution (executeTask) - Complete Override or Append
# MCP_PROMPT_EXECUTE_TASK=
# MCP_PROMPT_EXECUTE_TASK_APPEND=

# Task Verification (verifyTask) - Complete Override or Append
# MCP_PROMPT_VERIFY_TASK=
# MCP_PROMPT_VERIFY_TASK_APPEND=

# Task Completion (completeTask) - Complete Override or Append
# MCP_PROMPT_COMPLETE_TASK=
# MCP_PROMPT_COMPLETE_TASK_APPEND=

# List Tasks (listTasks) - Complete Override
# MCP_PROMPT_LIST_TASKS=

# Query Task (queryTask) - Complete Override or Append
# MCP_PROMPT_QUERY_TASK=
# MCP_PROMPT_QUERY_TASK_APPEND=

# Get Task Details (getTaskDetail) - Complete Override or Append
# MCP_PROMPT_GET_TASK_DETAIL=
# MCP_PROMPT_GET_TASK_DETAIL_APPEND=

# ============================
# Database Configuration
# ============================
# Options: 'sqlite' (default) or 'supabase'
DATABASE_PROVIDER=sqlite

# Supabase Configuration (Required if DATABASE_PROVIDER=supabase)
SUPABASE_PROJECT_URL=
# Use the "Service Role Key" (secret) to bypass RLS for backend operations
SUPABASE_SERVICE_ROLE_KEY=

# Legacy names still accepted:
# DATA_DIR, ENABLE_THOUGHT_CHAIN, TEMPLATES_USE, ENABLE_GUI, ENABLE_DETAILED_MODE,
# SERVER_PORT, ENABLE_AUTO_OPEN, DISABLE_AUTO_OPEN, DB_TYPE, SUPABASE_URL,
# SUPABASE_SERVICE_KEY

# ============================
# Findings Retention (Phase 1)
# ============================

# Maximum age (in days) of rows in `task_findings` before the nightly
# cleanup job removes them. Leave unset or empty to keep findings forever.
# FINDINGS_RETENTION_DAYS=

# ============================
# LLM Provider Layer (Phase 2)
# ============================
# Consumed by src/llm/* (Group 13 onwards). When LLM_PROVIDER is unset
# or `none`, the no-op provider is returned and any LLM call fails fast
# with PROVIDER_NOT_CONFIGURED — `workflow_run` falls back to manual
# mode in that case, so leaving these blank is safe.

# Default workflow mode: agent | manual | disabled
# WORKFLOW_MODE=manual

# Provider selection: openai | anthropic | openrouter | deepseek | none
# LLM_PROVIDER=none

# Optional explicit model id (otherwise selection strategy decides).
# Examples:
#   openai:    gpt-4o, gpt-4o-mini, o3-mini
#   anthropic: claude-3-5-sonnet-latest, claude-3-5-haiku-latest
#   openrouter: anthropic/claude-3.5-sonnet, openai/gpt-4o, meta-llama/llama-3.3-70b-instruct
#   deepseek:  deepseek-chat, deepseek-reasoner
# LLM_MODEL=

# Selection strategy: manual | latest_code | latest_reasoning | cheapest | fastest
# Used by Group 14 model-list resolution; ignored when LLM_MODEL is set.
# LLM_SELECTION_STRATEGY=manual

# When true, GUI/DB cannot override the env-supplied LLM configuration.
# Persisted llm_settings rows are read but ignored. Useful for locked
# deployments where ops controls the provider/model centrally.
# LLM_CONFIG_LOCK=false

# Cache TTL for per-provider model lists (Group 14).
# LLM_MODEL_REFRESH_TTL_HOURS=24

# Optional base-URL overrides for self-hosted or alt gateways.
# Defaults: https://openrouter.ai/api/v1 and https://api.deepseek.com/v1.
# OPENROUTER_BASE_URL=
# DEEPSEEK_BASE_URL=

# Provider API keys (env-only — NEVER persisted to llm_settings,
# NEVER returned by GET /api/llm/settings).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# ============================
# Logging & Observability
# ============================

# Pino log level: trace | debug | info | warn | error | fatal | silent
# Defaults: development → debug, test → silent, otherwise info.
# LOG_LEVEL=info

# When set to any truthy value, force JSON log output even in development
# (pino-pretty is used otherwise). Useful when piping logs to a collector.
# AGENTFLOW_LOG_JSON=1